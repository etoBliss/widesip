DATABASE_URL=postgresql://postgres:postgres@localhost:5432/widesip
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4000
# Optional locally. Set both keys together; production rejects empty or test keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Widesip-owned outbound mail provider. End users never add these credentials.
MAIL_TRANSPORT=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM=Widesip <accounts@your-verified-domain.com>
# Local owner-only Cloudflare connection for DNS provisioning tests.
# Create a token restricted to DNS Read + DNS Write for this zone only.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Local campaign testing: set this to the current HTTPS cloudflared Quick Tunnel URL.
WIDESIP_PUBLIC_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAMPAIGN_UNSUBSCRIBE_SECRET=
